# Copy this file to .env and fill in real values. .env itself is gitignored.

# SQLite for local dev (default if unset). For production use Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/retinova
DATABASE_URL=sqlite:///./retinova.db

# Secret used to sign login sessions (JWTs). Set this to a long random string
# in production — anyone with this value could forge valid logins.
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Anyone registering as a doctor must enter this code. This is a stand-in for
# real medical-credential verification — distribute it only to genuine
# clinicians on your team, and change it from the default before deploying.
DOCTOR_SIGNUP_CODE=RETINOVA-DOC-2026
